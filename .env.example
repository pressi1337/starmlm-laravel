# --- Uploaded video compression --------------------------------------------
# Compression is triggered PER UPLOAD, as a detached background process:
# finishing an upload starts "php artisan videos:compress --file=<name>" and
# returns immediately. Nothing to install, no worker, no cron.
#
# WHY NOT INSIDE THE REQUEST: ffmpeg there held the final chunk's response
# until nginx returned 504 after 64s, so every real video upload failed at
# 100% even though the file had merged correctly.
#
#   spawn (default) - detached process per upload. This is the one to use.
#   queue           - dispatch a job instead; needs "php artisan queue:work".
#   off             - never compress on upload (rely on the scheduled sweep
#                     or run "php artisan videos:compress" by hand).
#   defer           - encode after the response, inside the PHP-FPM worker.
#                     This is the mode that caused the 504. Do not use.
VIDEO_COMPRESS_MODE=spawn

# The PHP **CLI** binary that 'spawn' uses to run artisan.
# PHP_BINARY cannot be used: under PHP-FPM it points at the FPM binary, which
# will not run artisan. Leave as "php" if the CLI is on the web user's PATH;
# otherwise set an absolute path, e.g. /usr/bin/php8.2
PHP_CLI_BINARY=php

# Absolute path to ffmpeg if it is not on the system PATH.
# FFMPEG_PATH=/usr/bin/ffmpeg
# Quality dial (lower = better quality, bigger file) and max output height.
# FFMPEG_CRF=24
# FFMPEG_HEIGHT=720
